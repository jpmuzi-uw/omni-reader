seriesdesc == "150s FDG Qclear" ~ "QClear",
seriesdesc == "150s FDG Qclear - HPDL" ~ "Qclear HPDL",
seriesdesc == "150s FDG Qclear - MPDL" ~ "Qclear MPDL",
seriesdesc == "150s TOF AC" ~ "ToF OSEM",
seriesdesc == "150s QClear AC" ~ "QClear"
)) |>
mutate(
