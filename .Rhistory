sphere_data |>
filter(grepl("suv",measure)) |>
ggplot(aes(x = sph_dia, y = value,color = seriesdesc)) +
geom_line(aes(linetype = scanner),linewidth = 1) +
geom_point(size = 2) +
scale_x_continuous(breaks = c(10,13,17,22,28,37)) +
scale_color_paletteer_d("lisa::GustavKlimt") +
labs(
