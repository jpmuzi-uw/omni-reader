y = "SUV",
title = "SUV measure comparison for Omni & DMI",
subtitle = "NEMA IQ Phantom - Scan duration 150s",
color = "Reconstruction Type",
linetype = "Scanner"
) +
facet_wrap_interactive(~measure) +
theme_light()
